<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Qiban.DesktopProbe</AssemblyName>
    <!-- User-visible EXE version info only; the assembly name and identity stay as they were. -->
    <Product>栖伴 Qiban</Product>
    <AssemblyTitle>栖伴 Qiban</AssemblyTitle>
    <Company>栖伴</Company>
    <Version>0.9.9</Version>
    <FileVersion>0.9.9.1</FileVersion>
    <InformationalVersion>$(FileVersion)</InformationalVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets/qiban.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <WindowsSdkPackageVersion>10.0.22621.57</WindowsSdkPackageVersion>
    <BaseOutputPath>../../.dev/refactor-r0/desktop/build/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <EmbeddedResource Include="Assets/*" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets/room-stills/*.webp" LogicalName="room-stills/%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(IntermediateOutputPath)public-content.js" LogicalName="public-content.js" />
  </ItemGroup>
  <Target Name="GeneratePublicPages" BeforeTargets="PrepareResources;AssignTargetPaths"
          Inputs="build_public_pages.py;../../docs/桌面声明.md;../../docs/微信支持范围.md;../../docs/模型选择参考.md;../../LICENSE;../../THIRD_PARTY_NOTICES.md"
          Outputs="$(IntermediateOutputPath)public-content.js">
    <PropertyGroup>
      <PublicPagesPython Condition="'$(QIBAN_DESKTOP_PYTHON)' != ''">$(QIBAN_DESKTOP_PYTHON)</PublicPagesPython>
      <PublicPagesPython Condition="'$(PublicPagesPython)' == '' and Exists('../../.venv/Scripts/python.exe')">../../.venv/Scripts/python.exe</PublicPagesPython>
      <PublicPagesPython Condition="'$(PublicPagesPython)' == ''">python</PublicPagesPython>
    </PropertyGroup>
    <Exec Command="&quot;$(PublicPagesPython)&quot; build_public_pages.py &quot;$(IntermediateOutputPath)public-content.js&quot;" />
  </Target>
  <Target Name="PinWindowsSdkRuntime" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="10.0.14" />
      <FrameworkReference Update="Microsoft.WindowsDesktop.App.WindowsForms" RuntimeFrameworkVersion="10.0.14" />
    </ItemGroup>
  </Target>
  <Target Name="RemoveUnusedWebViewWpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
