{
  "EMOTION_CHANGE": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "valence_delta": {
        "type": "number",
        "minimum": -0.2,
        "maximum": 0.2
      },
      "arousal_delta": {
        "type": "number",
        "minimum": -0.2,
        "maximum": 0.2
      },
      "evidence_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "minItems": 1,
        "maxItems": 10
      }
    },
    "required": [
      "label",
      "reason",
      "valence_delta",
      "arousal_delta",
      "evidence_ids"
    ],
    "additionalProperties": false
  },
  "ANSWER": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,80}$"
      },
      "answer": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "required": [
      "id",
      "answer"
    ],
    "additionalProperties": false
  },
  "GRADE": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,80}$"
      },
      "passed": {
        "type": "boolean"
      },
      "reason": {
        "type": "string",
        "maxLength": 2000
      },
      "gap": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "required": [
      "id",
      "passed",
      "reason",
      "gap"
    ],
    "additionalProperties": false
  },
  "QUESTION": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,80}$"
      },
      "criterion": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5
      },
      "kind": {
        "enum": [
          "recall",
          "transfer",
          "counterexample"
        ]
      },
      "question": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "expected": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000
      },
      "rubric": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1500
      },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          },
          "required": [
            "source_id",
            "quote"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "criterion",
      "kind",
      "question",
      "expected",
      "rubric",
      "evidence"
    ],
    "additionalProperties": false
  }
}
